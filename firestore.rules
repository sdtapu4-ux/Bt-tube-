rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidQuality(q) {
      return q in ['AUTO', 'HD_1080', 'HD_720', 'SD_480', 'SD_360', 'SD_240', 'SD_144'];
    }

    function isValidUserAccount(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.streamOnMobileData is bool &&
             data.defaultQuality is string && isValidQuality(data.defaultQuality) &&
             data.autoplayNext is bool &&
             data.notificationsEnabled is bool;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'email',
                         'streamOnMobileData', 'defaultQuality',
                         'autoplayNext', 'notificationsEnabled',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'photoUrl',
                         'streamOnMobileData', 'defaultQuality',
                         'autoplayNext', 'notificationsEnabled',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUserAccount(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserAccount(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['streamOnMobileData', 'defaultQuality', 'autoplayNext', 'notificationsEnabled', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'streamOnMobileData', 'defaultQuality', 'autoplayNext', 'notificationsEnabled', 'updatedAt'])
                       );

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
